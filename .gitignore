# Whitelist: ignore everything, then include selected paths
/*
!/.gitignore
!/README.md
!/LICENSE
!/YZR.webp
!/.github/
!/data/

node_modules/
*.log
__pycache__/

# local-only, never published here (already excluded by /* above):
#   site/     -> the website, its own private repo (LykosTR/yzrnet)
#   blogger/  -> archive of the old Blogger site (themes.xml, templates, apps-script)

# local-only backups (not published)
.github/backup/
data/*/out/
